  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{F8AD0D46-556D-DA3E-D926-68F55BBCAABC}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>TS2Python</RootNamespace>
    <!-- Platform toolset, named once instead of repeated in four
         configurations. v145 ships with Visual Studio 2026 (v18); pass
         /p:TS2PythonToolset=v143 to build with the VS 2022 toolset instead.
         Must be set here, before the configuration groups that read it.
         verify-build-env.bat reports which toolsets are actually installed. -->
    <TS2PythonToolset Condition="'$(TS2PythonToolset)' == ''">v145</TS2PythonToolset>
    <!-- vcpkg manifest mode: MSBuild runs `vcpkg install` against
         cpp/vcpkg.json at the start of every build and drops artefacts under
         vcpkg_installed/. vcpkg itself is resolved from the submodule by
         vcpkg-local.props — `vcpkg integrate install` is NOT required. -->
    <VcpkgEnabled>true</VcpkgEnabled>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestInstall>true</VcpkgManifestInstall>
    <VcpkgAutoLink>true</VcpkgAutoLink>
    <!-- Use vcpkg's internal applocal deploy path so the build does not
         depend on PowerShell 7 (pwsh.exe) being on PATH. -->
    <VcpkgXUseBuiltInApplocalDeps>true</VcpkgXUseBuiltInApplocalDeps>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!-- TradeStation hosts TS2Python.dll in its 32-bit process, so Win32 is the
       only production target. x64 configs are kept for developer smoke testing
       of the C++ code itself; NEVER deploy the x64 output to TradeStation. -->
  <PropertyGroup Condition="'$(Platform)'=='Win32'">
    <VcpkgTriplet>x86-windows</VcpkgTriplet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <VcpkgTriplet>x64-windows</VcpkgTriplet>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>$(TS2PythonToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(TS2PythonToolset)</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>$(TS2PythonToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(TS2PythonToolset)</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
