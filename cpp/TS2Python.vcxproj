  </ImportGroup>

  <!-- Repo-local vcpkg. Imported here, after the user property sheets, which
       is where `vcpkg integrate install` would otherwise inject a global,
       machine-specific one. See vcpkg-local.props. -->
  <Import Project="$(MSBuildThisFileDirectory)vcpkg-local.props" />

  <PropertyGroup Label="UserMacros" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <LinkIncremental>true</LinkIncremental>
    <TargetName>TS2Python</TargetName>
    <TargetExt>.dll</TargetExt>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
