<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local vcpkg integration for the MSBuild (.sln / Visual Studio) build.

  WHY THIS FILE EXISTS
  ====================
  Without it, building TS2Python.sln depends on `vcpkg integrate install`
  having been run once per user — a machine-global setting stored in
  %LOCALAPPDATA%\vcpkg\vcpkg.user.props that points at ONE vcpkg checkout,
  wherever that user happened to run it.

  Two ways that bites:

    1. The user never ran it. Nothing imports vcpkg, no include directory is
       ever added, and the build fails with
           error C1083: Cannot open include file: 'zmq.hpp'

    2. Worse, the user ran it from a DIFFERENT repo. The global props then
       points into that other checkout. If it still exists, this repo
       silently builds against another project's dependency tree; if it was
       moved or deleted, the import is skipped — its condition is
       Exists(...) — and you are back to C1083, with a global file that
       still looks correctly configured.

  Case 2 is not hypothetical: it is exactly what this repo hit.

  WHAT IT DOES
  ============
  Imports vcpkg's MSBuild integration directly out of the submodule at
  cpp/build-tools/vcpkg, so the path is derived from where THIS file sits
  and nothing outside the repo is consulted. vcpkg.props computes VcpkgRoot
  as $(MSBuildThisFileDirectory)..\..\.. relative to itself, so importing
  the submodule's copy roots vcpkg at the submodule. Setting
  VCPkgLocalAppDataDisabled (vcpkg's own opt-out, checked in the condition
  of the generated global props) suppresses the machine-global import so
  the two cannot both apply.

  Result: a recursive clone plus setup-build-env.bat is enough.
  `vcpkg integrate install` is neither required nor consulted, and a stale
  one cannot poison the build.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- Ignore %LOCALAPPDATA%\vcpkg\vcpkg.user.{props,targets}. Both are
         generated by `vcpkg integrate install` and both guard their import
         on this property being empty. -->
    <VCPkgLocalAppDataDisabled>true</VCPkgLocalAppDataDisabled>

    <!-- The vendored vcpkg, relative to this file. -->
    <TS2PythonVcpkgRoot>$(MSBuildThisFileDirectory)build-tools\vcpkg\</TS2PythonVcpkgRoot>

    <!-- VcpkgInstalledDir is deliberately NOT overridden.

         vcpkg's default is vcpkg_installed\$(VcpkgTriplet)\, and the include
         path it composes appends the triplet a second time, giving
         vcpkg_installed\x86-windows\x86-windows\include. That reads like a
         bug and is not one: the outer directory is a per-triplet install
         ROOT, the inner is the ordinary triplet folder inside it.

         Collapsing the two into one shared vcpkg_installed\ root breaks the
         x86 and x64 builds against each other. Manifest mode treats the
         install root as a managed tree and reconciles it against the current
         install plan, so building x64 removes the x86 packages, and the next
         x86 build fails with C1083 on a machine where it just succeeded.
         Keep the roots separate. -->
  </PropertyGroup>

  <!-- NOTE: TS2PythonToolset is deliberately NOT defined here. It has to be
       set before the per-configuration PropertyGroups that read it, and this
       file is imported after them — MSBuild evaluates properties in document
       order, so a default declared here would expand to empty. It lives in
       each project's Globals group instead. -->

  <Import Project="$(TS2PythonVcpkgRoot)scripts\buildsystems\msbuild\vcpkg.props"
          Condition="Exists('$(TS2PythonVcpkgRoot)scripts\buildsystems\msbuild\vcpkg.props')" />

  <!-- Fail loudly and early. Without this the submodule being uninitialised
       surfaces much later as C1083 on zmq.hpp, which reads like a vcpkg
       problem rather than a missing checkout. -->
  <Target Name="TS2PythonCheckVcpkgSubmodule" BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(TS2PythonVcpkgRoot)scripts\buildsystems\msbuild\vcpkg.props')">
    <Error Text="vcpkg submodule missing at $(TS2PythonVcpkgRoot). Run cpp\setup-build-env.bat to check it out and install the dependencies." />
  </Target>

</Project>
