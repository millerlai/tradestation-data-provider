__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.uv-cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.egg-info/
data/
dist/
build/

# ---- C++ build output (cpp/) -------------------------------------------
# Anything under per-config build dirs at any depth: cpp/Debug/, cpp/Release/,
# cpp/x64/, cpp/TS2Python/Debug/, cpp/TS2Pytho.<hash>/x64/Release/, ... etc.
cpp/Debug/
cpp/Release/
cpp/x64/
cpp/**/Debug/
cpp/**/Release/
cpp/**/x64/

# MSBuild intermediate-name folder VS auto-creates (cpp/TS2Pytho.<hash>/).
# Re-generated on every solution open, never useful in history.
cpp/TS2Pytho.*/

# Visual Studio IDE state.
cpp/.vs/

# vcpkg manifest mode: cpp/vcpkg_installed/ is generated by `vcpkg install`
# from cpp/vcpkg.json on every machine. Treat it like build/ — generated,
# host-specific, never checked in.
cpp/vcpkg_installed/

# Claude Code per-user permission overrides. `.local.json` is by definition a
# personal layer; committing it hands every collaborator an inherited allow
# list (this one carried `Bash(git push *)`), which contradicts the workflow
# rule that pushes are always explicit. Anything genuinely shared belongs in
# a reviewed `.claude/settings.json`.
.claude/settings.local.json

# Per-user / build-time files
*.user
*.suo
*.tlog
*.lib
*.dll
*.exp
*.pdb

# ...except the binaries we ship. cpp/prebuilt/ is the only place a .dll is
# checked in on purpose: it is what install-to-tradestation.bat falls back to
# for users who have no Visual Studio. Refresh it from a Release build.
!cpp/prebuilt/**/*.dll
*.obj
*.ilk
*.recipe
*.FileListAbsolute.txt
